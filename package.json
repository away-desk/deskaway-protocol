{
  "name": "@deskaway/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "The DeskAway wire contract: JSON Schemas, generated TypeScript types, and the one validator every JavaScript consumer uses.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/away-desk/deskaway-protocol.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./runtime/index.d.ts",
      "default": "./runtime/index.mjs"
    }
  },
  "files": [
    "runtime/",
    "generated/typescript/",
    "schemas/",
    "enums/",
    "examples/"
  ],
  "scripts": {
    "codegen": "node codegen/generate.mjs",
    "codegen:check": "node codegen/generate.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node scripts/validate.mjs",
    "validate:py": "python scripts/validate.py",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2"
  }
}
