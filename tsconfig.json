{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noEmit": true,
    "skipLibCheck": false,
    "types": []
  },
  "include": ["generated/typescript/**/*.d.ts", "runtime/**/*.d.ts", "test/types/**/*.ts"]
}
